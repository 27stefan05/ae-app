#!/bin/sh
# Wird von labwc beim Start ausgefuehrt (~/.config/labwc/autostart).
# Zeigt das Logo, bis die App antwortet, und startet Chromium dann im Kiosk.
# Stuerzt Chromium ab, startet die Schleife es neu.

# Bildschirm ins Hochformat drehen. labwc hat dafuer keine eigene rc.xml-Option.
# Alle angeschlossenen Ausgaenge, damit ein anderer Anschluss (HDMI statt DP)
# oder ein neuer Monitor nicht quer bleibt. Bei falscher Drehrichtung 90 <-> 270.
for output in $(wlr-randr | awk '/^[^ ]/ {print $1}'); do
    wlr-randr --output "$output" --transform 270
done

# Dieselbe Farbe und dasselbe Logo wie der Boot-Splash, damit dazwischen
# kein Terminal aufblitzt. swaybg laeuft schon in der gedrehten Aufloesung.
swaybg -c '#0078DC' -i /opt/ae-app/deploy/plymouth/logo.png -m center >/dev/null 2>&1 &
sleep 0.4
plymouth quit >/dev/null 2>&1 || true

# Die Bildschirmtastatur ist Teil der App (static/osk.js), kein eigenes Programm.

while true; do
    # Fehlerseite vermeiden, solange Gunicorn noch nicht antwortet.
    while ! curl -fsS -o /dev/null --max-time 2 http://127.0.0.1:5000/; do
        sleep 0.4
    done
    chromium-browser \
        --kiosk \
        --noerrdialogs \
        --disable-infobars \
        --incognito \
        --disable-translate \
        --disable-session-crashed-bubble \
        --no-first-run \
        --check-for-update-interval=31536000 \
        --disable-features=TranslateUI \
        --password-store=basic \
        --overscroll-history-navigation=0 \
        --disable-pinch \
        http://127.0.0.1:5000/
    sleep 2
done &
